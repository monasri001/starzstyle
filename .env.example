# StarzStyle application
SHOP_NAME=StarzStyle
NODE_ENV=production
PORT=3000
APP_HOST=0.0.0.0

# S3 image upload
S3_BUCKET=starzstyle-dress-shop-CHANGE-ME
S3_REGION=ap-south-1
S3_PREFIX=images
SKIP_S3_UPLOAD=false

# Lambda Function URL used to generate downloadable order receipts
NEXT_PUBLIC_DOWNLOAD_ORDER_URL=https://CHANGE-ME.lambda-url.ap-south-1.on.aws/

# PostgreSQL / RDS order storage (read by server.mjs only)
DB_HOST=starzstyle-db.CHANGE-ME.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=starzstyle
DB_USER=postgres
DB_PASS=CHANGE-ME
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=5
